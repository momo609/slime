+            self._training_active = True
+            
+            logger.info(f"[EagleTrainer rank {self.rank}] Training activated in {time.time() - start_ts:.2f}s")
+            return True
+            
+        except Exception as e:
+            logger.error(f"[EagleTrainer rank {self.rank}] Activation failed: {e}")
+            return False
