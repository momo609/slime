+
+import os
+
+import slime.utils.misc as U
+from slime.utils.external_utils.command_utils import execute_train_npu
+
+MODEL_NAME = os.environ.get("SLIME_SCRIPT_MODEL_NAME", "Qwen3-VL-8B-Instruct")
