+    eagle3_max_epochs: int = 10
+    eagle3_checkpoint_path: Optional[str] = None
+    eagle3_min_workers_for_training: int = 1
+    eagle3_collect_hidden_states: bool = True
+    
+    # Eagle3 model architecture
